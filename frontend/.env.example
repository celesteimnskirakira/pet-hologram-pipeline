PUBLIC_APP_URL=https://app.genpichong.dpdns.org
NEXT_PUBLIC_APP_TITLE=PETTA 全息随身宠物
NEXT_PUBLIC_APP_DESCRIPTION=上传宠物照片，生成动作并在全息设备上呈现。

# PostgreSQL connection string (used by Drizzle ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://petta:replace_with_database_password@127.0.0.1:5432/petta

# Python generation service and authenticated callback
GENERATION_BACKEND_URL=https://genpichong.dpdns.org
GENERATION_BACKEND_SECRET=
GENERATION_CALLBACK_BASE_URL=https://app.genpichong.dpdns.org
GENERATION_CALLBACK_SECRET=

# Self-hosted upload storage. The signing secret must be at least 32 characters.
PETTA_UPLOAD_SIGNING_SECRET=
PETTA_UPLOAD_URL_TTL_SECONDS=7200
