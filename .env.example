# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is gitignored and read automatically by the pipeline.
# Verify it was picked up with:  python cli.py doctor

# 生图服务商（OpenAI-compatible API）
# API key 请填在等号后，不要提交真实值。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai-next.com
IMAGE_API_PREFIX=/v1
IMAGE_MODEL=doubao-seedream-5-0-260128

# 生图服务商若同时提供视觉理解，请填写用于特征抽取的模型。
# 若该服务商不提供视觉模型，需要另配 VISION_API_KEY / VISION_BASE_URL / VISION_MODEL。
IMAGE_VISION_MODEL=

# 视频服务商：火山方舟官方 API。
# 请填方舟控制台生成的 key，不要提交真实值。
VIDEO_API_KEY=
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 请以方舟控制台显示的精确模型 ID 为准；不要把产品简称直接当作模型 ID。
VIDEO_MODEL=doubao-seedance-2-0-mini-260615

# 可选：独立视觉服务（仅当 IMAGE 服务商不支持视觉理解时使用）。
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=
