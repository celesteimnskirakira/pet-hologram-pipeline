# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is gitignored and read automatically by the pipeline.
# Verify it was picked up with:  python cli.py doctor

# Volcengine Ark key. This is the cheapest Seedance 2.0 mini route.
# Get it at https://console.volcengine.com/ark -> API Key management.
ARK_API_KEY=

# Optional fallback provider. Not Seedance; different price and output.
# AGNES_API_KEY=

# Optional model overrides. Defaults are pinned in petloop/config.py.
# ARK_VISION_MODEL=doubao-seed-1-6-flash-250828
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
