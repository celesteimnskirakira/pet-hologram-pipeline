# Copy to /etc/petta/backend.env with mode 0600. Never commit real values.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_API_PREFIX=
IMAGE_MODEL=doubao-seedream-5-0-260128
IMAGE_VISION_MODEL=

VIDEO_API_KEY=
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_MODEL=doubao-seedance-2-0-mini-260615

GENERATION_BACKEND_SECRET=
GENERATION_CALLBACK_SECRET=
GENERATION_ARTIFACT_SECRET=
PROJECTION_AGENT_SECRET=

GENERATION_PUBLIC_BASE_URL=https://genpichong.dpdns.org
GENERATION_ALLOWED_IMAGE_HOSTS=app.genpichong.dpdns.org
GENERATION_ALLOWED_CALLBACK_HOSTS=app.genpichong.dpdns.org
GENERATION_ARTIFACT_TTL_S=3600
GENERATION_MAX_CONCURRENT=1
GENERATION_ALLOW_LOCAL_HTTP=0
GENERATION_ALLOW_INSECURE_TLS=0
GENERATION_RUNS_DIR=/var/lib/petta/runs
PROJECTION_AGENT_URL=http://127.0.0.1:8001
PROJECTION_STORE=/var/lib/petta/projection
PROJECTION_MAX_ARTIFACT_BYTES=209715200
PROJECTION_ALLOW_LOCAL_HTTP=0
