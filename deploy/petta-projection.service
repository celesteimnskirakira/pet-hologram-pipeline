[Unit]
Description=Petta staging projection receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petta
Group=petta
WorkingDirectory=/opt/petta/backend
EnvironmentFile=/etc/petta/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/petta/backend/.venv/bin/python /opt/petta/backend/projection_agent.py --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/petta
MemoryMax=384M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
